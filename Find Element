
#include <iostream>
using namespace std;
int main()
{
  int size=5;
  int element=0;
  int index=0;
  int founded=0;
  int arr[size]={10,20,40,30,50};

  for(int i=0;i<size;i++)
  {
      cout<<arr[i]<<" ";
  }
  cout<<endl;

  cout<<" Enter the element that you want to search on :";
  cin>>element;

  for(int i=0;i<size;i++)
  {
      if(element==arr[i])
      {
          index=i;
          founded=1;
      }
  }
   if(founded==1)
   {
       cout<<"founded"<<endl;
       cout<<"index of element is "<<index<<endl;
   }
   else
   {
       cout<<" not founded "<<endl;
   }
    return 0;


}
