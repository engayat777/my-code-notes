#include <iostream>
using namespace std;
int main()
{
    int size=5;
    int element=0;
    int index=0;
    int arr[size]={10,20,30,40,50};

    cout<<"Array before editing ";
    for(int i=0;i<size;i++)
    {
        cout<<arr[i]<<" ";
    }
    cout<<endl;

    cout<<"Enter element that you want to delete ";
    cin>>element;

    for(int i=0;i<size;i++)
    {
        if(element==arr[i])
        {
            index=i;
        }
    }

    for(int i=index;i<size-1;i++)
    {
        arr[i]=arr[i+1];
    }
    size--;
    cout<<endl;
